# Copy this file to deploy/.env.render and fill it in. That file is git-ignored
# and must never be committed, pasted into a chat or printed to a terminal.
#
# It is only for running commands from Windows AGAINST the hosted database:
# migrations, the first ingest, the first re-screen. The hosted service itself
# reads none of it - Render holds its own copy of these values, entered in the
# dashboard.
#
# Load it into the current PowerShell session with:
#     . .\deploy\Use-DeployEnv.ps1
# and close the window when you are done.

# The Supabase Session pooler URL, port 5432, from
# Supabase > Project > Connect > Session pooler.
# Percent-encode any of : / ? # [ ] @ that appear in the password.
DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# The shared sign-in. Kept here so there is one place that has them; the copies
# that matter are the ones entered in the Render dashboard.
# Generate the secret with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_USERNAME=
AUTH_PASSWORD=
SESSION_SECRET=
