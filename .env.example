# Copy to .env and edit. Never commit .env.
# Every value here has a default in src/watchdog/core/settings.py, so a fresh
# clone runs with no .env at all.

# SQLAlchemy URL. SQLite locally; a Supabase Session pooler URL when hosted, which
# is rewritten to postgresql+psycopg:// with sslmode=require before it is used.
DATABASE_URL=sqlite:///data/watchdog.db

# Language model. "disabled" is the default and the whole application works with it.
LLM_PROVIDER=disabled
LLM_MODEL=
LLM_API_KEY=
LLM_ENDPOINT=

# DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Cache directory. May be deleted at any time; nothing durable lives here.
DATA_DIR=data

# "dev" gives human-readable console logs; anything else gives JSON, and anything
# other than dev/development/local means hosted: sign-in and PostgreSQL become
# compulsory and the process refuses to start without them.
ENVIRONMENT=dev

# The shared sign-in. Leave all three empty on a laptop and Watchdog runs with no
# sign-in at all. Set all three to require one - which is what a hosted service
# does whether they are set or not, by refusing to start until they are.
# SESSION_SECRET must be long and random:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_USERNAME=
AUTH_PASSWORD=
SESSION_SECRET=

# How long a sign-in lasts before it has to be typed again.
SESSION_HOURS=12
