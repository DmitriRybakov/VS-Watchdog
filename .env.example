# Copy to .env and edit. Never commit .env.
# Every value here has a default in src/watchdog/core/settings.py, so a fresh
# clone runs with no .env at all.

# SQLAlchemy URL. SQLite locally, postgresql+psycopg://... on Render and Azure.
DATABASE_URL=sqlite:///data/watchdog.db

# Language model. "disabled" is the default and the whole application works with it.
LLM_PROVIDER=disabled
LLM_MODEL=
LLM_API_KEY=
LLM_ENDPOINT=

# DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Cache directory. May be deleted at any time; nothing durable lives here.
DATA_DIR=data

# "dev" gives human-readable console logs; anything else gives JSON.
ENVIRONMENT=dev
